omod FUSION-LOGIC is
  protecting GEOMETRY .
  protecting DRONE-BRAIN .

  subsort loc < Position .
  subsort Dir3D < Dir .

  vars O : Oid .
  vars V : loc .
  vars B W : Rat .
  var MS : Configuration .
  var EP : Position .

  op trustThreshold : -> Rat .
  eq trustThreshold = 1/1 . 

  op consensusBonus : -> Rat .
  eq consensusBonus = 1/50 .

  op sumWeights : Configuration -> Rat .
  eq sumWeights(none) = 0/1 .
  eq sumWeights(msg(O, V, B) MS) = B + sumWeights(MS) .

  op sumWPos : Configuration -> Position .
  eq sumWPos(none) = v(0, 0, 0) .
  eq sumWPos(msg(O, V, B) MS) = (V * B) + sumWPos(MS) .

  op sumBeliefWeights : loc Configuration -> Rat .
  eq sumBeliefWeights(EP, none) = 0/1 .
  eq sumBeliefWeights(EP, msg(O, V, B) MS) = 
     (B * (if distSq(EP, V) > 4/1 then 1/2 else 1/1 fi)) + sumBeliefWeights(EP, MS) .

  ceq calcEstPos(EP, B, MS) = 
      (if (W >= trustThreshold) 
      then (((EP * B) + sumWPos(MS)) / (B + W)) 
      else EP fi)
      if W := sumWeights(MS) .

  ceq calcBelief(B, EP, MS) = 
    (if (W >= trustThreshold) 
     then (if (B + (consensusBonus * W) > 1/1) then 1/1 else (B + (consensusBonus * W)) fi) 
     else (if B > 1/50 then B - 1/50 else 0/1 fi) fi)
    if W := sumBeliefWeights(EP, MS) .
endom