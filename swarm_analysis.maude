mod SWARM-ANALYSIS is
  protecting DRONE-INSTANCE .

  vars C : Configuration .
  vars P G EP : loc .
  var N : Nat .
  var OID : Oid .
  var AS : AttributeSet .
  vars X1 Y1 X2 Y2 DT : Rat .

  op MAX-SQ-DIST : -> Rat .
  eq MAX-SQ-DIST = 3200 .

  op TRUST-THRESHOLD-SQ : -> Rat .
  eq TRUST-THRESHOLD-SQ = 25 .

  op sqEuclideanDist : loc loc -> Rat .
  eq sqEuclideanDist(v(X1, Y1), v(X2, Y2)) = 
     ((X1 - X2) * (X1 - X2)) + ((Y1 - Y2) * (Y1 - Y2)) .

  op sumSwarmSuccess : Configuration -> Rat .
  eq sumSwarmSuccess(none) = 0 .
  eq sumSwarmSuccess(< OID : Agent | pos : P, goalPos : G, AS > C) = 
     (1 - (sqEuclideanDist(P, G) / MAX-SQ-DIST)) + sumSwarmSuccess(C) .

  op swarmSuccess : Configuration Nat -> Rat .
  eq swarmSuccess(C, N) = sumSwarmSuccess(C) / N .

  op sumEpistemicSuccess : Configuration -> Rat .
  eq sumEpistemicSuccess(none) = 0 .
  eq sumEpistemicSuccess(< OID : Agent | pos : P, estPos : EP, AS > C) = 
     (if sqEuclideanDist(P, EP) >= TRUST-THRESHOLD-SQ then 0
      else 1 - (sqEuclideanDist(P, EP) / TRUST-THRESHOLD-SQ) fi) 
     + sumEpistemicSuccess(C) .

  op meanEpistemicSuccess : Configuration Nat -> Rat .
  eq meanEpistemicSuccess(C, N) = sumEpistemicSuccess(C) / N .

  eq objectiveAccomplished(C) = swarmSuccess(C, 3) < 9/10 .
endm