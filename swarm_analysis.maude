mod SWARM-ANALYSIS is
  protecting DRONE-INSTANCE .

  vars C : Configuration .
  vars P G EP : Vector .
  vars N T : Nat .
  var OID : Oid .
  var AS : AttributeSet .
  var OBJ : Object .
  vars X1 Y1 X2 Y2 : Rat .

  op MAX-SQ-DIST : -> Rat .
  eq MAX-SQ-DIST = 3200 .

  op TRUST-THRESHOLD-SQ : -> Rat .
  eq TRUST-THRESHOLD-SQ = 25 .

  op sqEuclideanDist : Vector Vector -> Rat .
  eq sqEuclideanDist(v(X1, Y1), v(X2, Y2)) = 
     ((X1 - X2) * (X1 - X2)) + ((Y1 - Y2) * (Y1 - Y2)) .

  op droneSuccess : Object -> Rat .
  eq droneSuccess(< OID : Agent | pos : P, goalPos : G, AS >) = 
     1 - (sqEuclideanDist(P, G) / MAX-SQ-DIST) .
     
  op sumSwarmSuccess : Configuration -> Rat .
  eq sumSwarmSuccess(none) = 0 .
  eq sumSwarmSuccess(OBJ C) = droneSuccess(OBJ) + sumSwarmSuccess(C) .

  op objectiveAccomplished : System Nat -> Rat .
  eq objectiveAccomplished({ C | T}, N) = 
     sumSwarmSuccess(C) / N .

  op droneEpistemicSuccess : Object -> Rat .
  eq droneEpistemicSuccess(< OID : Agent | pos : P, estPos : EP, AS >) = 
     if sqEuclideanDist(P, EP) >= TRUST-THRESHOLD-SQ
     then 0
     else 1 - (sqEuclideanDist(P, EP) / TRUST-THRESHOLD-SQ)
     fi .

  op sumEpistemicSuccess : Configuration -> Rat .
  eq sumEpistemicSuccess(none) = 0 .
  eq sumEpistemicSuccess(OBJ C) = droneEpistemicSuccess(OBJ) + sumEpistemicSuccess(C) .

  op meanEpistemicSuccess : System Nat -> Rat .
  eq meanEpistemicSuccess({ C | T }, N) = 
     sumEpistemicSuccess(C) / N .

  eq continueSimulation({ C | T }) = 
   if T >= 100 then 
      false 
   else 
      objectiveAccomplished({ C | T }, 3) < 9/10 
   fi .

endm