search [1, 30] in SWARM-ANALYSIS : 
  {
    < d(1) : Agent | pos : v(0, 0, 0), 
                     estPos : v(0, 0, 0), 
                     goalPos : v(30, 30, 30), 
                     belief : 1/1, 
                     speed : 1/1, 
                     heading : E, 
                     inbox : emptyMsg > } 
  =>* { C } 
  such that objectiveAccomplished(C) .