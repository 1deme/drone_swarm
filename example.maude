search [1, 10] in SWARM-META-ANALYSIS : 
  initAnalysis(
    < d(1) : Agent | pos : v(0, 0, 0),
                     estPos : v(0, 0, 0),
                     goalPos : v(10, 10, 10),
                     belief : 1/1,
                     speed : 1/1,
                     heading : E,
                     inbox : none >
      < d(2) : Agent | pos : v(5, 5, 5),
                     estPos : v(5, 5, 5),
                     goalPos : v(20, 20, 20),
                     belief : 1/1,
                     speed : 1/1,
                     heading : E,
                     inbox : none >
  )
  =>* [ { C:Configuration } | N:Nat, IC:Nat ] 
  such that N:Nat >= 10 and not metaObjectiveAccomplished(C:Configuration, IC:Nat) .