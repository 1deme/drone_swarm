search [1, 7] in SWARM-META-ANALYSIS : 
  initAnalysis(
    < d(1) : Drone | pos : v(10, 10, 10),
                     estPos : v(10, 10, 10),
                     goalPos : v(10, 10, 10),
                     belief : 1/1,
                     speed : 1/1,
                     heading : E,
                     inbox : none >
      < d(2) : Drone | pos : v(21, 21, 21),
                     estPos : v(21, 21, 21),
                     goalPos : v(20, 20, 20),
                     belief : 1/1,
                     speed : 1/1,
                     heading : E,
                     inbox : none >
  )
  =>* [ { C:Configuration } | N:Nat, IC:Nat ] 
  such that N:Nat == 7 and not metaObjectiveAccomplished(C:Configuration, IC:Nat) .

  reduce resolveCollisions(< d(1) : Drone | pos : v(0,0,0), estPos : v(0,0,0), goalPos : v(5,0,0), belief : 1/1, speed : 1/1, heading : E, inbox : none > 
  < d(2) : Drone | pos : v(2,0,0), estPos : v(2,0,0), goalPos : v(0,0,0), belief : 1/1, speed : 1/1, heading : W, inbox : none >
   < d(3) : Drone | pos : v(0,5,0), estPos : v(0,5,0), goalPos : v(0,10,0), belief : 1/1, speed : 1/1, heading : N, inbox : none >) .





search [1, 15] in SWARM-META-ANALYSIS :
  initAnalysis(
    < d(1) : Drone | pos : v(0, 0, 0),
                     estPos : v(0, 0, 0),
                     goalPos : v(10, 10, 10),
                     belief : 1/1,
                     speed : 1/1,
                     heading : E,
                     inbox : none >
  )
  =>* [ { C:Configuration } | N:Nat, IC:Nat ]
  such that N:Nat >= 15 and not metaObjectiveAccomplished(C:Configuration, IC:Nat) .