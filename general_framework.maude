omod GENERAL-FRAMEWORK is
  protecting NAT .
  protecting RAT .

  sorts Dir .

  sorts Position Disturbance DisturbanceSet .
  subsort Disturbance < DisturbanceSet .
  
  op noneDist : -> DisturbanceSet [ctor] .
  op _;_ : DisturbanceSet DisturbanceSet -> DisturbanceSet [assoc comm id: noneDist] .

  msg msg : Oid Position Rat -> Msg .

  class Agent | pos : Position, estPos : Position, goalPos : Position, 
                belief : Rat, speed : Rat, heading : Dir, inbox : Configuration .

  sort System .
  op { _ } : Configuration -> System [ctor] .

  vars C C' Acc : Configuration . 
  var O : Object .
  vars P EP P' : Position .
  vars B S : Rat .
  var H : Dir .
  var AS AS' : AttributeSet .
  vars ID ID1 : Oid .
  var T N : Nat .
  var D : Disturbance .
  var DS : DisturbanceSet .


  op hasReliablePerception : Position -> Bool .
  op inCommunicationRange : Position Position -> Bool .
  op updatePhysicalState : Position Rat Dir Disturbance  -> Position .
  op estimateNextPosition : Position Rat Dir  -> Position .
  op isCollision : Position Position -> Bool .
  op crashThresholdSq : -> Rat .
  op possibleDisturbances : -> DisturbanceSet .

  op perceiveEnvironment : Configuration -> Configuration .
  eq perceiveEnvironment(none) = none .
  eq perceiveEnvironment(< ID : Agent | pos : P, estPos : EP, belief : B > C) = 
     (if hasReliablePerception(P) 
      then < ID : Agent | pos : P, estPos : P, belief : 1/1 >
      else < ID : Agent | pos : P, estPos : EP, belief : B > fi) 
     perceiveEnvironment(C) .

  op broadcastAll : Configuration -> Configuration .

  op thinkAll : Configuration -> Configuration .
  op think : Object -> Object . 
  eq thinkAll(none) = none .
  eq thinkAll(O C) = think(O) thinkAll(C) .

  op applyPhysicsAcc : Configuration Configuration Disturbance -> Configuration .
  
  eq applyPhysicsAcc(none, Acc, D) = Acc .
  
  eq applyPhysicsAcc((< ID : Agent | pos : P, estPos : EP, speed : S, heading : H > C), Acc, D) =
     applyPhysicsAcc(
        C, 
        Acc (< ID : Agent | 
                pos : updatePhysicalState(P, S, H, D),
                estPos : estimateNextPosition(EP, S, H) >),
        D
      ) .

  op applyPhysics : Configuration Disturbance -> Configuration .
  eq applyPhysics(C, D) = applyPhysicsAcc(C, none, D) .

  op resolveChronological : Configuration -> Configuration .

  op performStep : Configuration Disturbance -> Configuration .
    eq performStep(C, D) = 
      broadcastAll(
        applyPhysics(
          resolveChronological(
            thinkAll(
              perceiveEnvironment(C)
            )
          ), 
          D
        )
      ) .

  crl [performBigStep] : { C } => { performStep(C, D) } 
      if D ; DS := possibleDisturbances .

endom