omod BROADCAST is
  protecting GENERAL-FRAMEWORK .

  vars C-REM C-FIN C-CUR C-FULL : Configuration .
  vars S-ID R-ID : Oid .
  vars S-P S-EP R-P : Position .
  vars S-B : Rat .
  vars MS : AgentMsgSet .
  vars AS : AttributeSet .
  var M : AgentMsg .

  eq broadcastAll(C-FULL) = bc-loop(C-FULL, C-FULL) .

  op bc-loop : Configuration Configuration -> Configuration .
  eq bc-loop(none, C-CUR) = C-CUR .
  
  eq bc-loop((< S-ID : Agent | pos : S-P, estPos : S-EP, belief : S-B, AS > C-REM), C-CUR) =
     bc-loop(C-REM, deliver(msg(S-ID, S-EP, S-B), S-P, C-CUR, none)) .

  op deliver : AgentMsg Position Configuration Configuration -> Configuration .
  
  eq deliver(msg(S-ID, S-EP, S-B), S-P, (< R-ID : Agent | pos : R-P, inbox : MS, AS > C-REM), C-FIN) =
     if (S-ID =/= R-ID) and inCommunicationRange(S-P, R-P) then
        deliver(msg(S-ID, S-EP, S-B), S-P, C-REM, (< R-ID : Agent | inbox : (MS ; msg(S-ID, S-EP, S-B)), pos : R-P, AS > C-FIN))
     else
        deliver(msg(S-ID, S-EP, S-B), S-P, C-REM, (< R-ID : Agent | pos : R-P, inbox : MS, AS > C-FIN)) fi .
        
  eq deliver(M, S-P, none, C-FIN) = C-FIN .
  
endom