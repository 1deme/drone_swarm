mod DRONE-SYSTEM is
  protecting DRONE-BRAIN .
  protecting NAT .
  protecting RANDOM .

  sort System .
  op { _ , _ } : Configuration Nat -> System [ctor] .

  vars C C' : Configuration . 
  var O : Object .
  vars P P' EP G W : Vector .
  vars B S : Rat .
  vars H NEW-H : Dir8 .
  var AS AS' : AttributeSet .
  var ID ID1 : Oid .
  var T Seed : Nat .

  op worldBox : -> Box .
  eq worldBox = box(0, 0, 20, 20) .

  op radioRange : -> Rat .
  eq radioRange = 5 .

  op doStep : Configuration Vector Nat -> Configuration .
  eq doStep(C, W, T) = moveAll(thinkAll(broadcastAll(restoreSignals(C, T), worldBox, radioRange)), W) .

  op thinkAll : Configuration -> Configuration .
  eq thinkAll(none) = none .
  eq thinkAll(O C) = think(O) thinkAll(C) . 

  op moveAll : Configuration Vector -> Configuration .
  eq moveAll(none, W) = none .
  eq moveAll((< ID : Drone | pos: P, estPos: EP, belief: B, speed: S, heading: H, AS > C), W) =
     (< ID : Drone | 
         pos: ((P + (dirToVec(H) * S)) + W), 
         estPos: (EP + (dirToVec(H) * S)), 
         belief: (if B > 1/100 then B - 1/100 else 0 fi), 
         speed: S, heading: H, AS >) 
     moveAll(C, W) .


  rl [tick-calm] : { C , T } => { doStep(C, v(0, 0), T) , T + 1 } .
  rl [tick-east] : { C , T } => { doStep(C, v(1/10, 0), T) , T + 1 } .
  rl [tick-west] : { C , T } => { doStep(C, v(-1/10, 0), T) , T + 1 } .

  op restoreSignals : Configuration Nat -> Configuration .
  eq restoreSignals(none, Seed) = none .
  
  eq restoreSignals(< ID : Drone | pos: P, estPos: EP, belief: B, AS > C, Seed) =
     if (random(Seed) rem 100) < 5 
     then < ID : Drone | pos: P, estPos: P, belief: 1, AS > restoreSignals(C, Seed + 1)
     else < ID : Drone | pos: P, estPos: EP, belief: B, AS > restoreSignals(C, Seed + 1) fi .

  ceq { < ID : Drone | pos: P, AS > < ID1 : Drone | pos: P', AS' > C , T } = { C , T } 
    if distSq(P, P') < 1/4 .

endm