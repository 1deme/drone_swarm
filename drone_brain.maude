mod DRONE-BRAIN is
  protecting BROADCAST .
  protecting GENERAL-FRAMEWORK .

  vars P P2 G EP NEW-EP LEADER-P : Position .
  vars O O2 : Oid .
  vars B B2 S currDist nextDist NEW-B LEADER-B : Rat .
  vars H H1 H2 NEW-H : Dir .
  var AS : AttributeSet .
  var MS : Configuration .
  var M BEST-MSG : Msg .
  var D : Object .

  op think : Object -> Object .
  ceq think(D) =
      < O : Drone | pos : P,
                    estPos : NEW-EP,
                    goalPos : G,
                    belief : NEW-B,
                    speed : calcSpeed(NEW-EP, NEW-H, NEW-B, MS), 
                    heading : NEW-H,
                    inbox : none >
      if < O : Drone | pos : P, estPos : EP, goalPos : G, belief : B, speed : S, heading : H, inbox : MS > := D
      /\ NEW-EP := calcEstPos(EP, MS)
      /\ NEW-B  := calcBelief(B, MS)
      /\ NEW-H  := bestDir(NEW-EP, G) .
      
  op calcBelief : Rat Configuration -> Rat .
  op calcEstPos : Position Configuration -> Position .
  op calcSpeed : Position Dir Rat Configuration -> Rat .
  op bestDir : Position Position -> Dir .
  
endm