mod DRONE-BRAIN is
  protecting BROADCAST .
  protecting FUZZY-SPEED-CONTROL .
  protecting FUSION-LOGIC .

  vars P P2 G EP NEW-EP LEADER-P : Vector .
  vars O O2 : Oid .
  vars B B2 S currDist nextDist NEW-B LEADER-B : Rat .
  vars H H1 H2 NEW-H : Dir8 .
  var AS : AttributeSet .
  var MS : DroneMsgSet .
  var M BEST-MSG : DroneMsg .
  var D : Object .

  op getBelief : DroneMsg -> Rat .
  eq getBelief(dMsg(O, P, B)) = B .

  op getPos : DroneMsg -> Vector .
  eq getPos(dMsg(O, P, B)) = P .

  op think : Object -> Object .
  ceq think(D) =
      < O : Drone | pos : P, 
                    estPos : NEW-EP, 
                    goalPos : G, 
                    belief : NEW-B, 
                    speed : calcSpeed(< O : Drone | estPos : NEW-EP, heading : NEW-H, belief : NEW-B, inbox : MS >), 
                    heading : NEW-H, 
                    inbox : emptyMsg >
      if < O : Drone | pos : P, estPos : EP, goalPos : G, belief : B, speed : S, heading : H, inbox : MS > := D
      /\ NEW-EP := calcEstPos(D)
      /\ NEW-B  := calcBelief(D)
      /\ NEW-H  := bestDir(NEW-EP, G) .   
      
  ---pass currentPosition desired posiiton and Two candidate directions. check which puts you closes to desired position
  op betterDir : Vector Vector Dir8 Dir8 -> Dir8 .
  eq betterDir(P, G, H1, H2) = 
    if distSq(P + dirToVec(H1), G) < distSq(P + dirToVec(H2), G) 
    then H1 else H2 fi .

  ---check for each direction
  op bestDir : Vector Vector -> Dir8 .
  eq bestDir(P, G) = 
    betterDir(P, G, 
      betterDir(P, G, 
        betterDir(P, G, N, NE), 
        betterDir(P, G, E, SE)
      ), 
      betterDir(P, G, 
        betterDir(P, G, S, SW), 
        betterDir(P, G, W, NW)
      )
    ) .
endm