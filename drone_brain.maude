mod DRONE-BRAIN is
  protecting BROADCAST .
  protecting GENERAL-FRAMEWORK .

  vars P P2 G EP NEW-EP FUSED-EP PROJ-EP LEADER-P : Position .
  vars O O2 : Oid .
  vars B B2 S currDist nextDist NEW-B FUSED-B PROJ-B NEW-S LEADER-B : Rat .
  vars H H1 H2 NEW-H : Dir .
  var AS : AttributeSet .
  var MS : Configuration .
  var M BEST-MSG : Msg .


  op think : Object -> Object .
  ceq think(< O : Drone 
  | pos : P, estPos : EP, goalPos : G, belief : B, speed : S, heading : H, inbox : MS >) =
      < O : Drone | pos : P,
                    estPos : PROJ-EP,
                    goalPos : G,
                    belief : PROJ-B,
                    speed : NEW-S, 
                    heading : NEW-H,
                    inbox : none >
      if FUSED-EP := (if hasReliablePerception(P) then P else calcEstPos(EP, B, MS) fi)
      /\ FUSED-B  := (if hasReliablePerception(P) then 1/1 else calcBelief(B, EP, MS) fi)
      /\ NEW-H    := bestDir(FUSED-EP, G)
      /\ NEW-S    := calcSpeed(FUSED-EP, NEW-H, FUSED-B, MS)
      /\ PROJ-EP  := estimateNextPosition(FUSED-EP, NEW-S, NEW-H, period)
      /\ PROJ-B   := projectBelief(FUSED-B, period) .

op projectBelief : Rat Rat -> Rat .      
  op calcBelief : Rat Position Configuration -> Rat .
  op calcEstPos : Position Rat Configuration -> Position .
  op calcSpeed : Position Dir Rat Configuration -> Rat .
  op bestDir : Position Position -> Dir .
  
endm